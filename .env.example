# Copy to .env.local (gitignored) or export in your shell. Never commit a real key.
GEMINI_API_KEY=your-gemini-api-key
# Optional: override the primary model (default gemini-3.8-flash)
# GEMINI_MODEL=gemini-3.8-flash
# Optional fallback when Gemini is busy or slow: DeepSeek's own API (deepseek-flash = V4.1 Flash, image input)
# DEEPSEEK_API_KEY=your-deepseek-key
