# Copy to .env.local (gitignored) or export in your shell. Never commit a real key.
GEMINI_API_KEY=your-gemini-api-key
# Optional: override the primary model (default gemini-3.8-flash)
# GEMINI_MODEL=gemini-3.8-flash
# Optional fallbacks, tried in order when Gemini is busy or slow:
# OPENROUTER_API_KEY=your-openrouter-key   # DeepSeek V4.1 Flash, then openai/gpt-5.4-mini — one key covers both
# OPENAI_API_KEY=your-openai-key           # only used for gpt-5.4-mini when no OpenRouter key is set
